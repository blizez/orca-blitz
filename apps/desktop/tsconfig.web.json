{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/renderer/*", "../../packages/ui/src/*"],
      "@orca-blitz/ui/*": ["../../packages/ui/src/*"],
      "@orca-blitz/shared": ["../../packages/shared/src/index.ts"],
      "@orca-blitz/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src/renderer/**/*", "../../packages/ui/src/**/*.ts", "../../packages/ui/src/**/*.tsx", "../../packages/shared/**/*.ts"]
}
