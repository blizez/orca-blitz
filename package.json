{
  "name": "orca-blitz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @orca-blitz/desktop dev",
    "dev:web": "pnpm --filter @orca-blitz/desktop dev:web",
    "build": "pnpm --filter @orca-blitz/desktop build",
    "preview": "pnpm --filter @orca-blitz/desktop preview",
    "test": "pnpm -r --if-present test",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.21.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "oxfmt": "^0.18.0",
    "oxlint": "^1.79.0"
  }
}
