{
  "name": "orca-blitz",
  "version": "1.0.0",
  "private": true,
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @orca-blitz/desktop dev",
    "dev:web": "pnpm --filter @orca-blitz/desktop dev:web",
    "build": "pnpm --filter @orca-blitz/desktop build",
    "preview": "pnpm --filter @orca-blitz/desktop preview",
    "test": "pnpm -r --if-present test",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,md,css,html}": [
      "oxfmt --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.18.0",
    "oxlint": "^1.79.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.21.0",
      "onFail": "download"
    }
  }
}
